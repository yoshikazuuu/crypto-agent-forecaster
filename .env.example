# CryptoAgentForecaster Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM API Keys (you need at least one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# CoinGecko API Key (optional, but recommended for higher rate limits)
COINGECKO_API_KEY=your_coingecko_api_key_here

# LLM Configuration (leave empty to be prompted interactively)
# Default choices: gemini-2.5-flash (google) or gpt-5-nano (openai)
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=

# Rate Limiting
API_RATE_LIMIT_DELAY=1.0

# Logging
LOG_LEVEL=INFO 